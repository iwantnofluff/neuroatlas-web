# Copy to .env.local and fill in. Never commit real values.

# Sanity (journal content)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_API_READ_TOKEN=

NEXT_PUBLIC_SITE_URL=

# Klaviyo (waitlist, newsletter, contact form). One private API key with
# Full Access on Events, List, Profiles and Subscriptions, and nothing else.
# List IDs are under Klaviyo > Audience > Lists & segments > the list > Settings.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_WAITLIST_LIST_ID=
KLAVIYO_NEWSLETTER_LIST_ID=
